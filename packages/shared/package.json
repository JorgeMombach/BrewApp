{
  "name": "@brewapp/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gerar:tipos": "openapi-typescript openapi/openapi.json --output src/api/esquema.gerado.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verificar:traducoes": "vitest run src/i18n/paridadeDasTraducoes.test.ts",
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "formatar": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
