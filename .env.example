# Copie para .env e troque os valores marcados com "troque-me".
# O .env nunca vai para o Git (ver .gitignore). Aqui só entram placeholders.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=brewapp
# Superusuário do container, usado apenas na inicialização do banco
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me

# Role dona das tabelas: usada pelo Flyway para aplicar as migrations
BREWAPP_DB_OWNER_USER=brewapp_owner
BREWAPP_DB_OWNER_PASSWORD=troque-me

# Role da aplicação: não é dona das tabelas, para que o RLS seja aplicado (spec 9.3)
BREWAPP_DB_APP_USER=brewapp_app
BREWAPP_DB_APP_PASSWORD=troque-me

# --- Keycloak -----------------------------------------------------------------
KEYCLOAK_PORT=8180
# Admin inicial do console do Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=troque-me
KEYCLOAK_REALM=brewapp

# --- Backend ------------------------------------------------------------------
BREWAPP_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Emissor e destinatário validados nos tokens (spec 9.1)
BREWAPP_OAUTH_ISSUER_URI=http://localhost:8180/realms/brewapp
BREWAPP_OAUTH_AUDIENCE=brewapp-api
# Origens permitidas no CORS, separadas por vírgula (spec 9.5)
BREWAPP_CORS_ALLOWED_ORIGINS=http://localhost:5173
