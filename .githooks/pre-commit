#!/bin/sh
# Bloqueia o commit se houver segredos nos arquivos em stage.
# Ativado por "git config core.hooksPath .githooks" (script prepare do package.json).

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks não encontrado no PATH. Instale com: winget install Gitleaks.Gitleaks" >&2
    echo "pre-commit: commit bloqueado para não passar sem varredura de segredos." >&2
    exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --verbose
status=$?

if [ $status -ne 0 ]; then
    echo "pre-commit: gitleaks encontrou possíveis segredos. Remova-os do stage antes de commitar." >&2
fi

exit $status
